---
import Base from './Base.astro';
import AdminNav from '../components/AdminNav.tsx';
interface Props { title: string; heading: string; description: string; }
const { title, heading, description } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/admin';
---
<Base title={title} description={description} noindex={true}>
  <section class="container" style="padding-block:var(--sp-8) var(--sp-12);">
    <p style="letter-spacing:0.14em;text-transform:uppercase;font-size:var(--fs-100);color:var(--c-ink-faint);margin:0 0 var(--sp-2);">
      Lrnon admin
    </p>
    <h1 style="font-size:var(--fs-500);margin:0 0 var(--sp-6);">{heading}</h1>

    {/* The tab list lives in volunteer-roles.js, so the nav, the desk and the role
        form cannot disagree about who may open what. */}
    <AdminNav client:load here={here} />

    <slot />
  </section>
</Base>
