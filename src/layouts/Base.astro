---
import '../styles/tokens.css';
import '../styles/sky.css';
import '../styles/i18n.css';
import AccessibilityPanel from '../components/AccessibilityPanel.tsx';
import AccountMenu from '../components/AccountMenu.tsx';
import PageSearch from '../components/PageSearch.tsx';
import { CONTACT_EMAIL, CONTACT_PHONE, FUNDING_MODE, GOOGLE_REVIEW_URL } from '../lib/site-config';
import SkyBuddy from '../components/SkyBuddy.tsx';
import Telemetry from '../components/Telemetry.tsx';
import { SKY_COPY } from '../lib/sky-config';
import LanguagePicker from '../components/LanguagePicker.tsx';
import ChromeLang from '../components/ChromeLang.tsx';
import { localeFor } from '../i18n/locales.js';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import enUi from '../i18n/ui/en.json';
/* `lang` is the language the PAGE is written in. English pages are the default; a
   translated lesson passes its own, with the catalogue `ui` it was reviewed with, and
   `alternates` lists the other versions of the same page for search engines and for
   the language picker. */
interface Props { title: string; description: string; noindex?: boolean; lang?: string; ui?: Record<string, string>; alternates?: { code: string; htmlLang: string; href: string }[]; }
const { title, description, noindex = false, lang = 'en', ui, alternates = [] } = Astro.props;
const locale = localeFor(lang) ?? localeFor('en')!;
const T = (key: string) => (ui && ui[key]) || (enUi as Record<string, string>)[key] || key;
/* The languages a learner may pick right now: those whose translation has been reviewed by a
   person (see src/i18n/locales.js). Written by scripts/build-i18n.mjs before every build; absent
   or empty means English only, and then no picker is shown. */
type Offered = { code: string; htmlLang: string; name: string; native: string; dir: 'ltr' | 'rtl'; ui: boolean; lessons: number };
let offered: Offered[] = [];
try {
  const f = join(process.cwd(), 'public/i18n/live.json');       // the repository root, at build time
  if (existsSync(f)) offered = JSON.parse(readFileSync(f, 'utf8')).languages ?? [];
} catch { /* English only */ }
/* The design's founder switch: when funding is hidden, the Support link is not
   rendered anywhere, not merely hidden with CSS. */
const showSupport = FUNDING_MODE !== 'hidden';
/* Sky is built into every page. That is the companion: a greeting, a next step
   and a view of progress, for everyone, costing nothing and sending nothing.

   This decides that Sky EXISTS on the page, not who may use the assistant
   inside it. The assistant (the part that answers questions, costs money and
   sends the question to an outside provider) is gated by the rollout stage in
   three independent layers, none of them here: the island offers it only to
   the audience the stage admits and shows everyone else why it is closed, the
   route refuses regardless of what the browser was persuaded to render, and
   the deployed ceiling in sky-config.ts can only be widened by a commit.
   Showing the companion to everyone widens none of that. */
---
<!doctype html>
<html lang={locale.htmlLang} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#3d3d8f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <!-- GSC verification, redeploy check -->
    <meta name="google-site-verification" content="pwnYLQZJbNx6YeSW4EUSaZC4WiGsb15eQcPvjLVCITA" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* SVG first — ~300 bytes, sharp at every size. The PNG stays as a
        fallback for browsers that do not take SVG favicons. */}
    <link rel="icon" href="/icons/lrnon-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.htmlLang} href={a.href} data-code={a.code} />)}
    {/* Reader preferences, applied BEFORE first paint. This has to be inline
        and synchronous: a React island or a deferred script would run after
        the browser has already painted the default theme, so every reload
        would flash white before going dark.

        The mapping is duplicated from src/lib/progress-store.ts on purpose —
        pre-paint code cannot import a module. scripts/test-progress.mjs
        asserts the two stay in step, and scripts/generate-headers.mjs hashes
        this script into the CSP at build time, so no policy change is needed.

        Wrapped in try/catch because localStorage throws outright in some
        privacy modes, and a throw here would block the page from rendering. */}
    <script is:inline>
      (function () {
        try {
          var D = { theme: 'system', textsize: 'normal', leading: 'normal',
                    width: 'normal', contrast: 'normal', font: 'default', saver: 'off',
                    motion: 'system' };
          var A = { theme: 'data-theme', textsize: 'data-textsize', leading: 'data-leading',
                    width: 'data-width', contrast: 'data-contrast', font: 'data-font',
                    saver: 'data-saver', motion: 'data-motion' };
          var r = (JSON.parse(localStorage.getItem('ol.settings.v1') || '{}').reader) || {};
          var el = document.documentElement;
          for (var k in D) {
            var v = r[k];
            if (typeof v === 'string' && v !== D[k]) el.setAttribute(A[k], v);
          }
        } catch (e) { /* defaults are fine */ }
      })();
    </script>
    <script is:inline src="/register-sw.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n="skip">{T('skip')}</a>
    <header class="container" style="display:flex;justify-content:space-between;align-items:center;gap:var(--sp-4);padding-block:var(--sp-4);flex-wrap:wrap;">
      {/* translate="no" + .notranslate stop Google Translate rendering the
          brand as a phrase — a brand should never be machine-translated.
          The mark takes alt="" because the adjacent word is already the
          accessible name; announcing both would read "Lrnon Lrnon". */}
      <a href="/" translate="no" class="brand notranslate" aria-label="Lrnon — home">
        <img src="/icons/lrnon-mark.svg" width="26" height="26" alt="" />
        <span>Lrnon</span>
      </a>
      {/* The turn 7 header: seven destinations, then search, accessibility and
          the avatar. flex-wrap is not cosmetic — without it the nav was 524px
          wide inside a 422px viewport and every page scrolled sideways on a
          phone. Links wrap onto a second line rather than collapsing into a
          hamburger, because a wrapped nav needs no JavaScript, no focus trap
          and no aria-expanded to get right. */}
      <nav aria-label={T('nav.main')} data-i18n-aria="nav.main" style="display:flex;gap:var(--sp-3) var(--sp-4);align-items:center;flex-wrap:wrap;">
        <a href="/home" data-i18n="nav.home">{T('nav.home')}</a>
        <a href="/roadmap" data-i18n="nav.learn">{T('nav.learn')}</a>
        <a href="/doubts" data-i18n="nav.doubts">{T('nav.doubts')}</a>
        <a href="/community" data-i18n="nav.community">{T('nav.community')}</a>
        <a href="/members" data-i18n="nav.members">{T('nav.members')}</a>
        <a href="/whats-new" data-i18n="nav.whatsNew">{T('nav.whatsNew')}</a>
        {/* Moved up from the footer: asking people to spread the word and to tell
            us what is wrong are the two things a learner can do for Lrnon, and a
            footer link is where good intentions go to be missed. */}
        <a href="/share" data-i18n="nav.spread">{T('nav.spread')}</a>
        <a href="/feedback" data-i18n="nav.feedback">{T('nav.feedback')}</a>
        {GOOGLE_REVIEW_URL && <a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer"><span data-i18n="nav.rate">{T('nav.rate')}</span><span class="sr-only"> (opens in a new tab)</span></a>}
        <a href="/community#more" data-i18n="nav.more">{T('nav.more')}</a>
        {offered.length > 0 && <LanguagePicker client:idle lang={lang} languages={offered} />}
        <PageSearch client:idle />
        {/* One button, everything inside — design turn 3. The moment someone
            needs bigger text is the moment they are struggling with THIS page,
            so the fix must not require navigating away to a settings screen. */}
        <AccessibilityPanel client:load />
        {/* Replaces ProgressChip in the header. The chip's numbers are not
            lost: turn 7 moves level and streak onto /home's greeting line, and
            the menu carries them on every other page. */}
        <AccountMenu client:load />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    {/* The site had no contact detail anywhere before this: no footer address,
        no help route, no way to report a broken lesson. That is a real gap on
        a learning site, so the details now sit on every page. */}
    <footer style="background:var(--c-surface-2);border-top:1px solid var(--c-border);margin-top:var(--sp-16);">
      <div class="container" style="padding-block:var(--sp-12);font-size:var(--fs-100);">
        <div style="display:grid;gap:var(--sp-8);grid-template-columns:repeat(auto-fit,minmax(200px,1fr));">
          <div>
            <p translate="no" class="brand notranslate" style="margin:0 0 var(--sp-2);">
              <img src="/icons/lrnon-mark.svg" width="22" height="22" alt="" />
              <span>Lrnon</span>
            </p>
            <p style="margin:0;color:var(--c-ink-soft);max-width:30ch;" data-i18n="footer.tagline">{T('footer.tagline')}</p>
          </div>

          <nav aria-label="Learn">
            <h2 style="font-size:var(--fs-100);font-family:var(--font-body);text-transform:uppercase;letter-spacing:0.08em;color:var(--c-ink-faint);margin:0 0 var(--sp-2);" data-i18n="footer.learn">{T('footer.learn')}</h2>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:var(--sp-2);">
              <li><a href="/roadmap" data-i18n="footer.roadmap">{T('footer.roadmap')}</a></li>
              <li><a href="/review" data-i18n="footer.review">{T('footer.review')}</a></li>
              <li><a href="/achievements" data-i18n="footer.badges">{T('footer.badges')}</a></li>
              {/* Someone verifying a certificate arrives from a printout, not
                  from inside the site — but a link they can find beats asking
                  them to type a URL they half-remember. */}
              <li><a href="/v" data-i18n="footer.verify">{T('footer.verify')}</a></li>
              <li><a href="/account" data-i18n="footer.account">{T('footer.account')}</a></li>
            </ul>
          </nav>

          <nav aria-label="Project">
            <h2 style="font-size:var(--fs-100);font-family:var(--font-body);text-transform:uppercase;letter-spacing:0.08em;color:var(--c-ink-faint);margin:0 0 var(--sp-2);" data-i18n="footer.project">{T('footer.project')}</h2>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:var(--sp-2);">
              {showSupport && <li><a href="/support" data-i18n="footer.support">{T('footer.support')}</a></li>}
              <li><a href="/about" data-i18n="footer.about">{T('footer.about')}</a></li>
              <li><a href="/whats-new" data-i18n="nav.whatsNew">{T('nav.whatsNew')}</a></li>
              <li><a href="/community" data-i18n="nav.community">{T('nav.community')}</a></li>
              <li><a href="/volunteer" data-i18n="footer.volunteer">{T('footer.volunteer')}</a></li>
              <li><a href="/languages" data-i18n="footer.languages">{T('footer.languages')}</a></li>
              <li><a href="/feedback" data-i18n="nav.feedback">{T('nav.feedback')}</a></li>
              <li><a href="/share" data-i18n="nav.spread">{T('nav.spread')}</a></li>
              {GOOGLE_REVIEW_URL && <li><a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer" data-i18n="nav.rate">{T('nav.rate')}</a></li>}
            </ul>
          </nav>

          <div>
            <h2 style="font-size:var(--fs-100);font-family:var(--font-body);text-transform:uppercase;letter-spacing:0.08em;color:var(--c-ink-faint);margin:0 0 var(--sp-2);" data-i18n="footer.reach">{T('footer.reach')}</h2>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:var(--sp-2);">
              <li><a href={'mailto:' + CONTACT_EMAIL}>{CONTACT_EMAIL}</a></li>
              {CONTACT_PHONE && <li><a href={'tel:' + CONTACT_PHONE.replace(/\s/g, '')}>{CONTACT_PHONE}</a></li>}
            </ul>
            <p style="margin:var(--sp-2) 0 0;color:var(--c-ink-soft);" data-i18n="footer.reachNote">{T('footer.reachNote')}</p>
          </div>
        </div>

        <p style="margin:var(--sp-8) 0 0;padding-top:var(--sp-4);border-top:1px solid var(--c-border);color:var(--c-ink-soft);">
          © 2026 Lrnon · An independently built initiative, not yet a registered charity.
          Content CC BY-SA 4.0 · Code MIT. Free for learners, always: no paywalls, no dark patterns.
          · <a href="/reading" data-i18n="footer.reading">{T('footer.reading')}</a>
          · <a href="/safeguarding" data-i18n="footer.safety">{T('footer.safety')}</a>
          · <a href="/privacy" data-i18n="footer.privacy">{T('footer.privacy')}</a>
          · <a href="/terms" data-i18n="footer.terms">{T('footer.terms')}</a>
        </p>
      </div>
    </footer>

    {/* Two quiet counters: an anonymous page count and, for signed-in people, a
        sign-in record. See Telemetry.tsx and /privacy. */}
    <Telemetry client:idle />
    <ChromeLang client:idle lang={lang} languages={offered} />

    {/* Sky, the study buddy. Hidden by the island itself on /admin and on
        certification pages. */}
    <SkyBuddy client:idle intro={SKY_COPY.intro} disclaimer={SKY_COPY.disclaimer}
      suggestions={['Explain this lesson more simply', 'How is Lrnon funded?', 'How do I volunteer?']} />
  </body>
</html>
