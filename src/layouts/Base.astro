---
import '../styles/tokens.css';
import ProgressChip from '../components/ProgressChip.tsx';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d3d8f" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" />
    <script is:inline src="/register-sw.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="container" style="display:flex;justify-content:space-between;align-items:center;gap:var(--sp-4);padding-block:var(--sp-4);flex-wrap:wrap;">
      <a href="/" style="font-weight:700;text-decoration:none;color:var(--c-ink);">OpenLearn&nbsp;AI</a>
      <nav aria-label="Main" style="display:flex;gap:var(--sp-4);align-items:center;">
        <a href="/home" style="margin-inline-end:var(--sp-4);">Home</a>
        <a href="/review" style="margin-inline-end:var(--sp-4);">Review</a>
        <a href="/roadmap" style="margin-inline-end:var(--sp-4);">Roadmap</a>
        <a href="/achievements" style="margin-inline-end:var(--sp-4);">Badges</a>
        <a href="/account">Account</a>
        <ProgressChip client:load />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="container" style="padding-block:var(--sp-12);color:var(--c-ink-soft);font-size:var(--fs-100);">
      <p>Free forever. Open source. Content CC BY-SA 4.0 · Code MIT.
      No ads, no paywalls, no dark patterns.
      · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    </footer>
  </body>
</html>
