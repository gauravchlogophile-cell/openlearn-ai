---
import '../styles/tokens.css';
import ProgressChip from '../components/ProgressChip.tsx';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3d3d8f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <!-- GSC verification, redeploy check -->
    <meta name="google-site-verification" content="pwnYLQZJbNx6YeSW4EUSaZC4WiGsb15eQcPvjLVCITA" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* SVG first — ~300 bytes, sharp at every size. The PNG stays as a
        fallback for browsers that do not take SVG favicons. */}
    <link rel="icon" href="/icons/lrnon-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/icon-192.png" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    {/* Reader preferences, applied BEFORE first paint. This has to be inline
        and synchronous: a React island or a deferred script would run after
        the browser has already painted the default theme, so every reload
        would flash white before going dark.

        The mapping is duplicated from src/lib/progress-store.ts on purpose —
        pre-paint code cannot import a module. scripts/test-progress.mjs
        asserts the two stay in step, and scripts/generate-headers.mjs hashes
        this script into the CSP at build time, so no policy change is needed.

        Wrapped in try/catch because localStorage throws outright in some
        privacy modes, and a throw here would block the page from rendering. */}
    <script is:inline>
      (function () {
        try {
          var D = { theme: 'system', textsize: 'normal', leading: 'normal',
                    width: 'normal', contrast: 'normal', font: 'default', saver: 'off' };
          var A = { theme: 'data-theme', textsize: 'data-textsize', leading: 'data-leading',
                    width: 'data-width', contrast: 'data-contrast', font: 'data-font',
                    saver: 'data-saver' };
          var r = (JSON.parse(localStorage.getItem('ol.settings.v1') || '{}').reader) || {};
          var el = document.documentElement;
          for (var k in D) {
            var v = r[k];
            if (typeof v === 'string' && v !== D[k]) el.setAttribute(A[k], v);
          }
        } catch (e) { /* defaults are fine */ }
      })();
    </script>
    <script is:inline src="/register-sw.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="container" style="display:flex;justify-content:space-between;align-items:center;gap:var(--sp-4);padding-block:var(--sp-4);flex-wrap:wrap;">
      {/* translate="no" + .notranslate stop Google Translate rendering the
          brand as a phrase — a brand should never be machine-translated.
          The mark takes alt="" because the adjacent word is already the
          accessible name; announcing both would read "Lrnon Lrnon". */}
      <a href="/" translate="no" class="brand notranslate" aria-label="Lrnon — home">
        <img src="/icons/lrnon-mark.svg" width="26" height="26" alt="" />
        <span>Lrnon</span>
      </a>
      <nav aria-label="Main" style="display:flex;gap:var(--sp-4);align-items:center;">
        <a href="/home" style="margin-inline-end:var(--sp-4);">Home</a>
        <a href="/review" style="margin-inline-end:var(--sp-4);">Review</a>
        <a href="/roadmap" style="margin-inline-end:var(--sp-4);">Roadmap</a>
        <a href="/achievements" style="margin-inline-end:var(--sp-4);">Badges</a>
        <a href="/account">Account</a>
        <ProgressChip client:load />
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="container" style="padding-block:var(--sp-12);color:var(--c-ink-soft);font-size:var(--fs-100);">
      <p>Free forever. Open source. Content CC BY-SA 4.0 · Code MIT.
      No ads, no paywalls, no dark patterns.
      · <a href="/reading">Reading preferences</a>
      · <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></p>
    </footer>
  </body>
</html>
