---
/** One lesson page, in English or in a translation.
 *
 *  The English route and the translated route both render this, so a translated
 *  lesson cannot drift from the English one in layout, behaviour or accessibility:
 *  only the words differ. Everything structural (module, order, the tools named, the
 *  sources, the verified date) is read from the English lesson; the translation
 *  supplies the title, the objectives, the flashcards and the body.
 */
import CompleteButton from './CompleteButton.tsx';
import ModuleSidebar from './ModuleSidebar.tsx';
import LessonControls from './LessonControls.tsx';
import ReadAloud from './ReadAloud.tsx';
import LessonSources from './LessonSources.astro';
import { createHash } from 'node:crypto';
import { fmt } from '../i18n/live.js';

interface Props {
  lesson: any;                       // the English entry
  tr?: any;                          // the translation entry, when there is one
  Content: any;
  lang: string;                      // 'en' or a language code
  prefix: string;                    // '' or '/hi'
  t: (key: string) => string;
  all: any[];                        // the English lessons of this module, in order
  inLang: Set<string>;               // English ids that have a live translation in this language
  alternates: { code: string; native: string; htmlLang: string; href: string }[];
  modMeta?: { title?: string };
  trackMeta?: { title?: string };
  quizHref?: string;
  languageName?: string;
  reviewer?: string;
  reviewedOn?: string;
}
const { lesson, tr, Content, lang, prefix, t, all, inLang, alternates, modMeta, trackMeta, quizHref, languageName = '', reviewer = '', reviewedOn = '' } = Astro.props;

const hash = createHash('sha256').update(lesson.body ?? '').digest('hex').slice(0, 12);
const d = tr?.data ?? lesson.data;                       // the words
const idx = all.findIndex((l) => l.id === lesson.id);
const next = all[idx + 1];
const prev = all[idx - 1];
/* Inside a translation, a link goes to the translated lesson if there is one, and to the
   English lesson if there is not: never to a page that does not exist. */
const href = (l: any) => (lang !== 'en' && inLang.has(l.id) ? `${prefix}/learn/${l.id}` : `/learn/${l.id}`);
const sidebarLessons = all.map((l) => ({ slug: l.id, title: l.data.title, order: l.data.order }));
const here = lang === 'en' ? null : alternates.find((a) => a.code === 'en');
const labels = {
  mark: t('complete.mark'), markContinue: t('complete.markContinue'), continue: t('complete.continue'),
  quiz: t('complete.quiz'), finished: t('complete.finished'), skip: t('complete.skip'), xp: t('complete.xp'), locked: t('complete.locked'),
};
---
<div class="container lesson-shell" style="padding-block:var(--sp-8) var(--sp-12);">
  {/* The module rail. Ordered first in the DOM would put a long list of
      lessons between the header and the lesson for a screen reader, so it
      comes after the article and is placed alongside with CSS instead. */}
  <article>
  <div style="display:flex;justify-content:space-between;align-items:center;gap:var(--sp-4);flex-wrap:wrap;margin:0 0 var(--sp-3);">
    <nav aria-label="Breadcrumb" style="font-size:var(--fs-100);color:var(--c-ink-faint);">
      <a href="/" translate="no" class="notranslate">Lrnon</a>
      <span aria-hidden="true"> / </span>
      <a href="/roadmap">{trackMeta?.title ?? lesson.data.track}</a>
      <span aria-hidden="true"> · </span>
      <span>{lesson.data.module.toUpperCase()} · {modMeta?.title ?? ''}</span>
    </nav>
    {/* Text size, theme and streak, per design turn 2 — wanted mid-lesson,
        which is exactly when leaving for a settings page loses your place. */}
    <LessonControls client:idle />
  </div>

  {lang !== 'en' && (
    <p class="note note--aim" style="margin-block:0 var(--sp-4);font-size:var(--fs-100);">
      {fmt(t('lesson.translated'), { language: languageName, reviewer, date: reviewedOn })}
      {here && <> <a href={here.href} lang="en">{t('lang.readEnglish')}</a></>}
    </p>
  )}

  <p style="color:var(--c-ink-faint);font-size:var(--fs-100);margin:0;letter-spacing:0.06em;text-transform:uppercase;">
    {fmt(t('lesson.of'), { n: lesson.data.order, total: all.length })}
    · {fmt(t('lesson.minRead'), { n: d.minutes })} · {fmt(t('lesson.verified'), { date: lesson.data.lastVerified })}
  </p>
  <h1 style="font-size:var(--fs-500);margin-block:var(--sp-2) var(--sp-6);">{d.title}</h1>

  {/* Objectives use the indigo "aim" callout from the design system rather
      than a bare surface panel, so the three callout roles stay consistent
      across the site: aim = what you are about to do, try = do it now,
      ok = you got it right. */}
  <section class="note note--aim" aria-label={t('lesson.objectives')} style="margin-block-end:var(--sp-8);">
    <h2 style="font-size:var(--fs-200);margin:0 0 var(--sp-2);font-family:var(--font-body);">{t('lesson.objectives')}</h2>
    <ul style="margin:0;padding:0;list-style:none;display:grid;gap:var(--sp-2);">
      {d.objectives.map((o: string) => (
        <li style="display:flex;gap:var(--sp-2);align-items:baseline;">
          <span aria-hidden="true" style="color:var(--c-progress);">✓</span><span>{o}</span>
        </li>
      ))}
    </ul>
  </section>

  {lang === 'en' && alternates.length > 0 && (
    <p style="font-size:var(--fs-100);color:var(--c-ink-soft);margin-block:0 var(--sp-4);">
      {t('lang.available')}:
      {alternates.map((a, i) => <>{i > 0 && ' · '} <a href={a.href} hreflang={a.htmlLang} lang={a.htmlLang}>{a.native}</a></>)}
    </p>
  )}

  <ReadAloud client:idle />

  <div class="prose" lang={lang === 'en' ? undefined : alternates.find((a) => a.code === lang)?.htmlLang}>
    <Content />
  </div>

  <section class="card" aria-label="Flashcards added" style="margin-block:var(--sp-8);color:var(--c-ink-soft);">
    <p style="margin:0;">🗂 {fmt(t('lesson.flashcards'), { n: d.flashcards.length })}</p>
  </section>

  {/* Every tool this lesson names, with the vendor's own source and the date
      it was checked. Rendered from frontmatter so a lesson cannot name a
      product without sourcing it — see LessonSources for why that matters. */}
  <LessonSources ids={lesson.data.tools ?? []} sources={lesson.data.sources ?? []} />

  <nav aria-label="Lesson navigation" style="display:flex;justify-content:space-between;gap:var(--sp-4);align-items:center;flex-wrap:wrap;">
    <span style="display:flex;gap:var(--sp-2);align-items:center;flex-wrap:wrap;">
      {prev
        ? <a class="btn btn--ghost" href={href(prev)} rel="prev" title={prev.data.title}>{t('lesson.prev')}</a>
        : <a class="btn btn--ghost" href="/roadmap">{t('lesson.allModules')}</a>}
      <a class="btn btn--ghost" href="/home">{t('lesson.dashboard')}</a>
    </span>
    <CompleteButton client:load slug={lesson.id} hash={hash} labels={labels}
      nextHref={next ? href(next) : null} quizHref={quizHref} />
  </nav>

  {prev || next ? (
    <p style="margin-top:var(--sp-4);color:var(--c-ink-soft);font-size:var(--fs-100);">
      {prev && <span>{t('lesson.previous')}: <a href={href(prev)}>{prev.data.title}</a></span>}
      {prev && next && <span> · </span>}
      {next && <span>{t('lesson.next')}: <a href={href(next)}>{next.data.title}</a></span>}
    </p>
  ) : null}
  </article>

  <aside class="lesson-rail">
    <ModuleSidebar client:load
      moduleId={lesson.data.module}
      moduleTitle={modMeta?.title ?? ''}
      lessons={sidebarLessons}
      current={lesson.id} />
  </aside>
</div>
