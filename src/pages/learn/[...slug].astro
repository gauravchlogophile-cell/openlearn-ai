---
import Base from '../../layouts/Base.astro';
import CompleteButton from '../../components/CompleteButton.tsx';
import { getCollection, render } from 'astro:content';
import { createHash } from 'node:crypto';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((l) => ({ params: { slug: l.id }, props: { lesson: l } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const hash = createHash('sha256').update(lesson.body ?? '').digest('hex').slice(0, 12);
const all = (await getCollection('lessons'))
  .filter((l) => l.data.module === lesson.data.module)
  .sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((l) => l.id === lesson.id);
const next = all[idx + 1];
const quizBanks = import.meta.glob('../../../content/quizzes/*.json', { eager: true });
const hasQuiz = Object.values(quizBanks).some((b: any) => b.default.module === lesson.data.module);
const quizHref = hasQuiz ? '/quiz/' + lesson.data.module : undefined;
---
<Base title={lesson.data.title + ' — Learn On'} description={lesson.data.description}>
  <article class="container" style="padding-block:var(--sp-8) var(--sp-12);">
    <p style="color:var(--c-ink-soft);font-size:var(--fs-100);margin:0;">
      {lesson.data.module.toUpperCase()} · Lesson {lesson.data.order} of {all.length}
      · {lesson.data.minutes} min · last verified {lesson.data.lastVerified}
    </p>
    <h1 style="font-size:var(--fs-500);margin-block:var(--sp-2) var(--sp-6);">{lesson.data.title}</h1>

    <section aria-label="What you will learn" style="background:var(--c-surface);border-radius:var(--r-m);padding:var(--sp-4) var(--sp-6);margin-block-end:var(--sp-8);">
      <h2 style="font-size:var(--fs-200);margin:0 0 var(--sp-2);">In this lesson you will:</h2>
      <ul style="margin:0;padding-inline-start:var(--sp-6);">
        {lesson.data.objectives.map((o) => <li>{o}</li>)}
      </ul>
    </section>

    <div class="prose">
      <Content />
    </div>

    <section aria-label="Flashcards added" style="margin-block:var(--sp-8);color:var(--c-ink-soft);">
      <p>🗂 {lesson.data.flashcards.length} flashcards from this lesson join your daily review
      (review sessions arrive in Sprint 7).</p>
    </section>

    <nav aria-label="Lesson navigation" style="display:flex;justify-content:space-between;gap:var(--sp-4);align-items:center;">
      <a class="btn btn--ghost" href="/">All lessons</a>
      <CompleteButton client:load slug={lesson.id} hash={hash}
        nextHref={next ? '/learn/' + next.id : null} quizHref={quizHref} />
    </nav>
  </article>
</Base>
