---
import Base from '../../layouts/Base.astro';
import LessonView from '../../components/LessonView.astro';
import meta from '../../../content/modules.json';
import enUi from '../../i18n/ui/en.json';
import { getCollection, render } from 'astro:content';
import { LOCALES } from '../../i18n/locales.js';
import { liveVersionsOf } from '../../i18n/live.js';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((l) => ({ params: { slug: l.id }, props: { lesson: l } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const all = (await getCollection('lessons'))
  .filter((l) => l.data.module === lesson.data.module)
  .sort((a, b) => a.data.order - b.data.order);
const quizBanks = import.meta.glob('../../../content/quizzes/*.json', { eager: true });
const hasQuiz = Object.values(quizBanks).some((b: any) => b.default.module === lesson.data.module);
const quizHref = hasQuiz ? '/quiz/' + lesson.data.module : undefined;
const modMeta = meta.modules.find((m) => m.id === lesson.data.module);
const trackMeta = meta.tracks.find((t) => t.id === lesson.data.track);

/* The other versions of this lesson: only translations a person has reviewed. */
const alternates = liveVersionsOf(lesson.id).map((code) => {
  const l = LOCALES.find((x) => x.code === code)!;
  return { code, native: l.native, htmlLang: l.htmlLang, href: `/${code}/learn/${lesson.id}` };
});
const t = (key: string) => (enUi as Record<string, string>)[key] ?? key;
---
<Base title={lesson.data.title + ' — Lrnon'} description={lesson.data.description}
  alternates={alternates.length ? [{ code: 'en', htmlLang: 'en', href: `/learn/${lesson.id}` }, ...alternates] : []}>
  <LessonView lesson={lesson} Content={Content} lang="en" prefix="" t={t} all={all} inLang={new Set()}
    alternates={alternates} modMeta={modMeta} trackMeta={trackMeta} quizHref={quizHref} />
</Base>
