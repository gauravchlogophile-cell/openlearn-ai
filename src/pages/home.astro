---
import Base from '../layouts/Base.astro';
import Dashboard from '../components/Dashboard.tsx';
import { getCollection } from 'astro:content';
import meta from '../../content/modules.json';

const raw = await getCollection('lessons');
const cards = raw.flatMap((l) =>
  (l.data.flashcards ?? []).map((c, i) => ({
    key: l.id + '#' + i, front: c.front, back: c.back,
    lessonSlug: l.id, lessonTitle: l.data.title,
  }))
);
const lessons = (await getCollection('lessons'))
  .sort((a, b) => a.data.module.localeCompare(b.data.module) || a.data.order - b.data.order)
  .map((l) => ({ slug: l.id, title: l.data.title, minutes: l.data.minutes, module: l.data.module }));
---
<Base title="Home — Learn On"
  description="Your learning dashboard: continue where you left off, see module progress, and keep your streak going — all free, all yours.">
  <section class="container" style="padding-block:var(--sp-8) var(--sp-12);">
    <h1 style="font-size:var(--fs-500);">Welcome back</h1>
    <Dashboard client:load lessons={lessons} modules={meta.modules} cards={cards} />
  </section>
</Base>
