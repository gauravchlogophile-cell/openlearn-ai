---
import Base from '../layouts/Base.astro';
import RoomsGate from '../components/RoomsGate.tsx';
---
<Base title="Members & rooms — Lrnon"
  description="Public topic rooms and the people in them. Not open yet — no private messaging will ever exist here, and moderation comes first.">
  <section class="container" style="padding-block:var(--sp-12) var(--sp-12);max-width:900px;">
    <p style="letter-spacing:0.14em;text-transform:uppercase;font-size:var(--fs-100);color:var(--c-ink-faint);margin:0 0 var(--sp-3);">
      Public rooms only
    </p>
    <h1 style="font-size:var(--fs-600);margin:0 0 var(--sp-6);">Members & rooms</h1>

    <RoomsGate client:load
      title="Rooms"
      blurb="Public topic rooms, and a members list showing only a generated display name and a level. There is no direct messaging and there never will be — the policy forbids private channels, so the database has no table that could carry one.">
      <p>Rooms are open. The room list loads here.</p>
    </RoomsGate>
  </section>
</Base>
