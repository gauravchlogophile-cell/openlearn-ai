---
import Base from '../../layouts/Base.astro';
import Sandbox from '../../components/Sandbox.tsx';
import canned from '../../../content/canned/sandbox.json';
---
<Base title="Prompt Sandbox — Learn On"
  description="Explore curated prompt-and-output pairs with annotations — vague versus structured prompts, side by side. Live model runs arrive with accounts.">
  <section class="container prose" style="padding-block:var(--sp-8) var(--sp-12);">
    <h1 style="font-size:var(--fs-500);">Prompt Sandbox</h1>
    <p style="color:var(--c-ink-soft);">
      Real prompts, recorded outputs, and annotations on why they work. Every
      case here runs offline and costs nothing — by design.
    </p>
    <Sandbox client:load cases={canned.cases} />
  </section>
</Base>
