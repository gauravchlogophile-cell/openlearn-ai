---
import Base from '../layouts/Base.astro';
import AccountPanel from '../components/AccountPanel.tsx';
import GoalModeToggle from '../components/GoalModeToggle.tsx';
---
<Base title="Your account — Lrnon"
  description="Manage sign-in and progress sync. Anonymous learning always works; an account simply keeps your progress on every device.">
  <section class="container prose" style="padding-block:var(--sp-12);">
    <h1 style="font-size:var(--fs-500);">Your account</h1>
    <AccountPanel client:load />
    <h2 style="font-size:var(--fs-300);margin-top:var(--sp-12);">Preferences</h2>
    <GoalModeToggle client:load />
  </section>
</Base>
