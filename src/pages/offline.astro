---
import Base from '../layouts/Base.astro';
---
<Base title="Offline — Lrnon"
  description="You're offline. Lessons you saved for offline use keep working; everything else resumes automatically when you're back online.">
  <section class="container prose" style="padding-block:var(--sp-16);">
    <h1 style="font-size:var(--fs-500);">You're offline</h1>
    <p>No problem — learning here is designed for exactly this.</p>
    <p>Any module you saved with <strong>“Make available offline”</strong> still
    works fully, including quizzes. Your progress is recorded on this device
    and will sync when you're back online. Nothing is lost.</p>
    <p><a class="btn" href="/home">Go to your saved lessons</a></p>
  </section>
</Base>
