---
import Base from '../layouts/Base.astro';
import BadgeGrid from '../components/BadgeGrid.tsx';
import { getCollection } from 'astro:content';

const lessons = await getCollection('lessons');
const moduleTotals: Record<string, number> = {};
for (const l of lessons) moduleTotals[l.data.module] = (moduleTotals[l.data.module] ?? 0) + 1;
---
<Base title="Achievements — OpenLearn AI"
  description="Your badges — every criterion public, nothing hidden. Earned through learning, never through spending, because coins can't buy credentials here.">
  <section class="container" style="padding-block:var(--sp-8) var(--sp-12);">
    <h1 style="font-size:var(--fs-500);">Achievements</h1>
    <p class="prose" style="color:var(--c-ink-soft);">
      Every badge's criterion is public — there are no hidden achievements and
      nothing here can be bought. Badges celebrate habits; certificates (coming
      with module quizzes) attest skills. The two are deliberately separate.
    </p>
    <BadgeGrid client:load moduleTotals={moduleTotals} />
  </section>
</Base>
