{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openlearn-ai",
  "compatibility_date": "2026-07-10",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "89109907d15545819076c7708ff8db9b" }
  ]
}
