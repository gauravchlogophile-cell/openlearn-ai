{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Tool Registry Entry (Phase 3 §9)",
  "type": "object",
  "required": ["id", "vendor", "category", "summary", "capabilities", "docsUrl", "lastVerified", "verifier", "tier"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "vendor": { "type": "string" },
    "category": { "enum": ["assistant", "image", "video", "voice", "coding", "automation", "framework", "open-model", "workspace"] },
    "summary": { "type": "string", "minLength": 40, "maxLength": 240 },
    "capabilities": {
      "type": "object",
      "properties": {
        "chat": { "type": "boolean" }, "vision": { "type": "boolean" },
        "files": { "type": "boolean" }, "voice": { "type": "boolean" },
        "webSearch": { "type": "boolean" }, "api": { "type": "boolean" }
      }
    },
    "freeTierNotes": { "type": "string" },
    "docsUrl": { "type": "string", "format": "uri" },
    "tosNotes": { "type": "string" },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verifier": { "type": "string" },
    "tier": { "enum": ["A", "B", "C"] },
    "status": { "enum": ["active", "archived"], "default": "active" }
  }
}
